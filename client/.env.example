# Base URL of the Splitwise Pro API, including the /api prefix. It is public by
# design (the browser calls it), so it is safe to expose.
#
# Local development: http://localhost:4000/api (the Express server on port 4000).
# Production: set this in the Render dashboard for the splitwise-pro-client static
# site, e.g. https://<your-server>.onrender.com/api. Vite inlines it at build time,
# so a change needs a rebuild. Without it, a production build shows a setup error
# instead of calling any address.
VITE_API_BASE_URL=http://localhost:4000/api
